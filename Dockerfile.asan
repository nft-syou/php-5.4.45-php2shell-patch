FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        bison \
        build-essential \
        ca-certificates \
        curl \
        patch \
        pkg-config \
        re2c \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
